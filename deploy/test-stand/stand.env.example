# Test stand settings: non-secret flags and endpoints. Copy to stand.env on the server and edit.
# Secrets and connection URLs are generated by deploy.sh into .secrets/ and never live here.
# Validated against the API/Worker/Realtime config loaders at APP_ENV=staging.
#
# Production APP_ENV hard-disables games, communities and home in packages/config, so the test
# stand (and, until that is decided, the first public version) runs with APP_ENV=staging.
TEST_STAND_DOMAIN=test.lk2.padlhub.su
APP_ENV=staging
LOG_LEVEL=info
API_PORT=3000

        <mxCell id="21" value="SMS / OTP provider&#xa;только доставка кода, identity принадлежит PadlHub" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="20">

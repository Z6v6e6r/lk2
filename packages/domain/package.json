{
  "name": "@phub/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./notification-scenarios": {
      "types": "./src/notification-scenarios.ts",
      "import": "./dist/notification-scenarios.js"
    },
    "./training-registration": {
      "types": "./src/training-registration.ts",
      "import": "./dist/training-registration.js"
    },
    "./quarter-create": {
      "types": "./src/quarter-create.ts",
      "import": "./dist/quarter-create.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/notification-scenarios.ts src/training-registration.ts src/quarter-create.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run src"
  }
}

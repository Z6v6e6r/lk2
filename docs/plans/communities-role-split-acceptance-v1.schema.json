{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padlhub.invalid/contracts/communities-role-split-acceptance-v1.schema.json",
  "title": "Communities role-split acceptance envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "observedBefore",
    "observedAfter",
    "ownershipPlan",
    "grantPlan",
    "comparison",
    "decision"
  ],
  "properties": {
    "contractVersion": { "const": "communities-role-split-acceptance-v1" },
    "observedBefore": { "$ref": "#/$defs/inputC" },
    "observedAfter": { "$ref": "#/$defs/inputC" },
    "ownershipPlan": { "type": "array", "items": { "$ref": "#/$defs/ownershipDecision" } },
    "grantPlan": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/grantDecision" } },
    "comparison": { "$ref": "#/$defs/comparison" },
    "decision": { "$ref": "#/$defs/decision" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stableCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
    "roleCategory": {
      "enum": [
        "RESTORE_OWNER",
        "RESTORE_EXECUTOR",
        "SHARED_OWNER",
        "FUTURE_MIGRATOR",
        "FUTURE_RUNTIME",
        "INVENTORY_READER"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canLogin",
        "superuser",
        "bypassRls",
        "createDatabase",
        "createRole",
        "replication"
      ],
      "properties": {
        "canLogin": { "type": "boolean" },
        "superuser": { "type": "boolean" },
        "bypassRls": { "type": "boolean" },
        "createDatabase": { "type": "boolean" },
        "createRole": { "type": "boolean" },
        "replication": { "type": "boolean" }
      }
    },
    "mappingCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "roleNameSha256", "roleOidSha256", "capabilities", "evidenceSha256"],
      "properties": {
        "category": { "$ref": "#/$defs/roleCategory" },
        "roleNameSha256": { "$ref": "#/$defs/sha256" },
        "roleOidSha256": { "$ref": "#/$defs/sha256" },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "identityRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "requirement", "relation", "evidenceSha256"],
      "properties": {
        "left": { "$ref": "#/$defs/roleCategory" },
        "right": { "$ref": "#/$defs/roleCategory" },
        "requirement": { "enum": ["ALIAS_ALLOWED", "REQUIRED_DISTINCT"] },
        "relation": { "enum": ["SAME", "DISTINCT"] },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "mappingArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "categories", "identityRelations", "mappingDigest"],
      "properties": {
        "schemaVersion": { "const": "communities-role-split-mapping-v1" },
        "categories": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/mappingCategory" }
        },
        "mappingDigest": { "$ref": "#/$defs/sha256" },
        "identityRelations": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/identityRelation" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "markerDigest",
        "markerEvidenceDigest",
        "requestDigest",
        "creationReceiptSha256",
        "cloneNamePatternValid",
        "cloneOidBound",
        "sourceOidBound",
        "systemIdentifierDigest",
        "pgMajor",
        "objectManifestDigest",
        "ledgerDigest",
        "ledgerCount",
        "mappingDigest"
      ],
      "properties": {
        "contractVersion": { "const": "communities-role-split-clone-marker-evidence-v2" },
        "markerDigest": { "$ref": "#/$defs/sha256" },
        "markerEvidenceDigest": { "$ref": "#/$defs/sha256" },
        "requestDigest": { "$ref": "#/$defs/sha256" },
        "creationReceiptSha256": { "$ref": "#/$defs/sha256" },
        "cloneNamePatternValid": { "const": true },
        "cloneOidBound": { "const": true },
        "sourceOidBound": { "const": true },
        "systemIdentifierDigest": { "$ref": "#/$defs/sha256" },
        "pgMajor": { "const": 16 },
        "objectManifestDigest": { "$ref": "#/$defs/sha256" },
        "ledgerDigest": { "$ref": "#/$defs/sha256" },
        "ledgerCount": { "type": "integer", "minimum": 0 },
        "mappingDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "normalizedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKeySha256",
        "fieldKeySha256",
        "fieldKind",
        "observationState",
        "valueSha256",
        "provenanceSha256",
        "semantic"
      ],
      "properties": {
        "objectKeySha256": { "$ref": "#/$defs/sha256" },
        "fieldKeySha256": { "$ref": "#/$defs/sha256" },
        "fieldKind": {
          "enum": [
            "ROLE",
            "MEMBERSHIP",
            "OWNER",
            "ACL_EXPLICIT",
            "ACL_EFFECTIVE",
            "METADATA",
            "DEFAULT_ACL",
            "COLUMN",
            "RLS",
            "POLICY",
            "EXTENSION_MEMBER"
          ]
        },
        "observationState": { "enum": ["OBSERVED", "UNKNOWN", "UNOBSERVED"] },
        "valueSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "provenanceSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "semantic": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ownerCategory"],
              "properties": { "ownerCategory": { "$ref": "#/$defs/roleCategory" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["entries"],
              "properties": {
                "entries": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/aclEntry" }
                }
              }
            }
          ]
        }
      }
    },
    "aclEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granteeCategory", "privilege", "grantOption"],
      "properties": {
        "granteeCategory": {
          "oneOf": [{ "$ref": "#/$defs/roleCategory" }, { "enum": ["PUBLIC", "THIRD_PARTY"] }]
        },
        "privilege": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
        "grantOption": { "type": "boolean" }
      }
    },
    "normalizedRecords": { "type": "array", "items": { "$ref": "#/$defs/normalizedRecord" } },
    "normalizedInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "memberships",
        "databaseAcl",
        "schemas",
        "defaultAcls",
        "relations",
        "columnAcls",
        "rlsPolicies",
        "sequences",
        "functions",
        "types",
        "extensions"
      ],
      "properties": {
        "roles": { "$ref": "#/$defs/normalizedRecords" },
        "memberships": { "$ref": "#/$defs/normalizedRecords" },
        "databaseAcl": { "$ref": "#/$defs/normalizedRecords" },
        "schemas": { "$ref": "#/$defs/normalizedRecords" },
        "defaultAcls": { "$ref": "#/$defs/normalizedRecords" },
        "relations": { "$ref": "#/$defs/normalizedRecords" },
        "columnAcls": { "$ref": "#/$defs/normalizedRecords" },
        "rlsPolicies": { "$ref": "#/$defs/normalizedRecords" },
        "sequences": { "$ref": "#/$defs/normalizedRecords" },
        "functions": { "$ref": "#/$defs/normalizedRecords" },
        "types": { "$ref": "#/$defs/normalizedRecords" },
        "extensions": { "$ref": "#/$defs/normalizedRecords" }
      }
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count", "evidenceSha256"],
      "properties": {
        "code": { "$ref": "#/$defs/stableCode" },
        "count": { "type": "integer", "minimum": 1 },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inputC": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "canonicalizationVersion",
        "sortVersion",
        "provenance",
        "mapping",
        "normalized",
        "anomalies",
        "forbiddenCodeContract",
        "manifestSha256",
        "authorizes"
      ],
      "properties": {
        "schemaVersion": { "const": "communities-role-split-input-c-v1" },
        "canonicalizationVersion": { "const": "utf8-byte-digest-v1" },
        "sortVersion": { "const": "sha256-byte-v1" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "mapping": { "$ref": "#/$defs/mappingArtifact" },
        "normalized": { "$ref": "#/$defs/normalizedInventory" },
        "anomalies": { "type": "array", "items": { "$ref": "#/$defs/anomaly" } },
        "forbiddenCodeContract": { "type": "array", "items": { "$ref": "#/$defs/stableCode" } },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "authorizes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roleCreation",
            "roleRepair",
            "roleSplit",
            "aclMutation",
            "schemaMutation",
            "sharedDatabaseMutation",
            "migration",
            "deploy",
            "activation"
          ],
          "properties": {
            "roleCreation": { "const": false },
            "roleRepair": { "const": false },
            "roleSplit": { "const": false },
            "aclMutation": { "const": false },
            "schemaMutation": { "const": false },
            "sharedDatabaseMutation": { "const": false },
            "migration": { "const": false },
            "deploy": { "const": false },
            "activation": { "const": false }
          }
        }
      }
    },
    "ownershipDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKind",
        "objectKeySha256",
        "ownerFieldKeySha256",
        "beforeOwnerCategory",
        "targetOwnerCategory",
        "beforeOwnerValueSha256",
        "afterOwnerValueSha256",
        "ownerEvidenceSha256"
      ],
      "properties": {
        "objectKind": {
          "enum": ["database", "schema", "relation", "sequence", "function", "type", "extension"]
        },
        "objectKeySha256": { "$ref": "#/$defs/sha256" },
        "ownerFieldKeySha256": { "$ref": "#/$defs/sha256" },
        "beforeOwnerCategory": { "$ref": "#/$defs/roleCategory" },
        "targetOwnerCategory": {
          "oneOf": [{ "$ref": "#/$defs/roleCategory" }, { "const": "PRESERVE_CURRENT" }]
        },
        "beforeOwnerValueSha256": { "$ref": "#/$defs/sha256" },
        "afterOwnerValueSha256": { "$ref": "#/$defs/sha256" },
        "ownerEvidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "grantDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKind",
        "objectKeySha256",
        "fieldKeySha256",
        "action",
        "granteeCategory",
        "privileges",
        "beforeStateSha256",
        "targetStateSha256",
        "evidenceSha256",
        "grantOption"
      ],
      "properties": {
        "objectKind": {
          "enum": ["database", "schema", "relation", "sequence", "function", "type"]
        },
        "objectKeySha256": { "$ref": "#/$defs/sha256" },
        "fieldKeySha256": { "$ref": "#/$defs/sha256" },
        "action": { "enum": ["PRESERVE", "ADD", "REMOVE"] },
        "granteeCategory": { "$ref": "#/$defs/roleCategory" },
        "privileges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONNECT",
              "TEMPORARY",
              "USAGE",
              "CREATE",
              "SELECT",
              "INSERT",
              "UPDATE",
              "DELETE",
              "TRUNCATE",
              "REFERENCES",
              "TRIGGER",
              "EXECUTE"
            ]
          }
        },
        "beforeStateSha256": { "$ref": "#/$defs/sha256" },
        "targetStateSha256": { "$ref": "#/$defs/sha256" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" },
        "grantOption": { "const": false }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sortVersion",
        "beforeManifestSha256",
        "afterManifestSha256",
        "changedCount",
        "addedCount",
        "removedCount",
        "forbiddenTransitionCodes"
      ],
      "properties": {
        "sortVersion": { "const": "sha256-byte-v1" },
        "beforeManifestSha256": { "$ref": "#/$defs/sha256" },
        "afterManifestSha256": { "$ref": "#/$defs/sha256" },
        "changedCount": { "type": "integer", "minimum": 0 },
        "addedCount": { "type": "integer", "minimum": 0 },
        "removedCount": { "type": "integer", "minimum": 0 },
        "forbiddenTransitionCodes": { "type": "array", "items": { "$ref": "#/$defs/stableCode" } }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blockerCodes",
        "authorizesRoleCreation",
        "authorizesRoleAlteration",
        "authorizesAclMutation",
        "authorizesMigration",
        "authorizesDeploy",
        "authorizesRuntimeActivation"
      ],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "blockerCodes": { "type": "array", "items": { "$ref": "#/$defs/stableCode" } },
        "authorizesRoleCreation": { "const": false },
        "authorizesRoleAlteration": { "const": false },
        "authorizesAclMutation": { "const": false },
        "authorizesMigration": { "const": false },
        "authorizesDeploy": { "const": false },
        "authorizesRuntimeActivation": { "const": false }
      }
    }
  },
  "x-role-categories": [
    "RESTORE_OWNER",
    "RESTORE_EXECUTOR",
    "SHARED_OWNER",
    "FUTURE_MIGRATOR",
    "FUTURE_RUNTIME",
    "INVENTORY_READER"
  ],
  "x-observation-states": ["OBSERVED", "UNKNOWN", "UNOBSERVED"],
  "x-identity-relation-states": ["SAME", "DISTINCT"],
  "x-required-distinct-pairs": ["FUTURE_MIGRATOR|FUTURE_RUNTIME"],
  "x-frozen-contracts": ["29_V1", "32_V1", "33_V1", "34_V1"],
  "x-input-c-artifact-pins": [
    "beforeArtifactSha256",
    "afterArtifactSha256",
    "expectedMappingDigest",
    "creationReceiptSha256"
  ],
  "x-forbidden-transition-codes": [
    "ACL_PRIVILEGE_UNDECIDED",
    "COLUMN_GRANT_FORBIDDEN",
    "DEFAULT_ACL_CHANGE_FORBIDDEN",
    "EXTENSION_CHANGE_FORBIDDEN",
    "GRANT_OPTION_FORBIDDEN",
    "INPUT_C_ANOMALY_PRESENT",
    "INVENTORY_READER_OWNERSHIP_FORBIDDEN",
    "INVENTORY_READER_WRITE_FORBIDDEN",
    "MAPPING_INCOMPLETE",
    "MIXED_OWNER_FORBIDDEN",
    "NON_DETERMINISTIC_COMPARISON",
    "NORMALIZED_RECORD_UNKNOWN",
    "OUT_OF_MANIFEST_CHANGE_FORBIDDEN",
    "OWNER_TARGET_UNDECIDED",
    "OWNER_UNOBSERVED",
    "PUBLIC_GRANT_FORBIDDEN",
    "REQUIRED_DISTINCT_NOT_OBSERVED",
    "RESTORE_EXECUTOR_OWNERSHIP_FORBIDDEN",
    "RLS_POLICY_CHANGE_FORBIDDEN",
    "ROLE_CAPABILITY_FORBIDDEN",
    "ROLE_CATEGORY_IDENTITY_NOT_OBSERVED",
    "ROLE_MEMBERSHIP_FORBIDDEN",
    "RUNTIME_OWNERSHIP_FORBIDDEN",
    "RUNTIME_SCHEMA_CREATE_FORBIDDEN",
    "SHARED_DATABASE_CHANGE_FORBIDDEN",
    "THIRD_PARTY_GRANT_FORBIDDEN",
    "WILDCARD_GRANT_FORBIDDEN"
  ]
}

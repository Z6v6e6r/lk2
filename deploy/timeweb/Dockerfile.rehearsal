FROM docker.io/library/node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS build

WORKDIR /workspace

ARG PHUB_RELEASE
ARG PHUB_SOURCE_SHA
ARG PHUB_SOURCE_TREE

COPY . .

RUN npm ci \
  && npm run contracts:generate \
  && npm run build:packages \
  && npm run build:api \
  && npm run build:worker \
  && npm run build:migrator \
  && PHUB_RELEASE="$PHUB_RELEASE" npm run build -w @phub/web

FROM docker.io/library/node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS runtime

ARG PHUB_RELEASE
ARG PHUB_SOURCE_SHA
ARG PHUB_SOURCE_TREE

LABEL org.opencontainers.image.revision="$PHUB_SOURCE_SHA" \
  phub.source-tree="$PHUB_SOURCE_TREE" \
  phub.release-id="$PHUB_RELEASE" \
  phub.rehearsal-only="true"

ENV NODE_ENV=production
WORKDIR /app

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs appuser

COPY --from=build /workspace/package.json /workspace/package-lock.json ./
COPY --from=build /workspace/apps ./apps
COPY --from=build /workspace/packages ./packages
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/packages/database/migrations ./migrations
COPY --from=build /workspace/scripts/timeweb-beta-prepare-previous-schema.js ./scripts/timeweb-beta-prepare-previous-schema.js

RUN npm prune --omit=dev --workspaces

USER appuser

FROM docker.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS web

ARG PHUB_RELEASE
ARG PHUB_SOURCE_SHA
ARG PHUB_SOURCE_TREE

LABEL org.opencontainers.image.revision="$PHUB_SOURCE_SHA" \
  phub.source-tree="$PHUB_SOURCE_TREE" \
  phub.release-id="$PHUB_RELEASE" \
  phub.rehearsal-only="true"

COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html

FROM docker.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS proxy

ARG PHUB_RELEASE
ARG PHUB_SOURCE_SHA
ARG PHUB_SOURCE_TREE

LABEL org.opencontainers.image.revision="$PHUB_SOURCE_SHA" \
  phub.source-tree="$PHUB_SOURCE_TREE" \
  phub.release-id="$PHUB_RELEASE" \
  phub.rehearsal-only="true"

COPY deploy/timeweb/rehearsal-nginx.conf /etc/nginx/conf.d/default.conf

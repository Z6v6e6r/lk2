{
  "name": "@phub/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts src/contact-reader.ts src/local-password-login-repository.ts src/support-ticket-repository.ts src/local-password-reset-repository.ts src/notification-scenario-repository.ts src/managed-self-leave-repository.ts src/training-registration-repository.ts src/game-quarter-create-repository.ts src/tournament-notification-recipient.ts --format esm --dts --sourcemap --clean"
  },
  "dependencies": {
    "@phub/communities": "0.1.0",
    "@phub/domain": "0.1.0",
    "@phub/games": "0.1.0",
    "@phub/gift-certificates": "0.1.0",
    "@phub/home-projection": "0.1.0",
    "@phub/locations": "0.1.0",
    "pg": "8.22.0",
    "zod": "4.6.7"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contacts": {
      "types": "./src/contact-reader.ts",
      "import": "./dist/contact-reader.js"
    },
    "./password-login": {
      "types": "./src/local-password-login-repository.ts",
      "import": "./dist/local-password-login-repository.js"
    },
    "./support-tickets": {
      "types": "./src/support-ticket-repository.ts",
      "import": "./dist/support-ticket-repository.js"
    },
    "./password-reset": {
      "types": "./src/local-password-reset-repository.ts",
      "import": "./dist/local-password-reset-repository.js"
    },
    "./managed-self-leave": {
      "types": "./src/managed-self-leave-repository.ts",
      "import": "./dist/managed-self-leave-repository.js"
    },
    "./notification-scenarios": {
      "types": "./src/notification-scenario-repository.ts",
      "import": "./dist/notification-scenario-repository.js"
    },
    "./training-registration": {
      "types": "./src/training-registration-repository.ts",
      "import": "./dist/training-registration-repository.js"
    },
    "./tournament-notifications": {
      "types": "./src/tournament-notification-recipient.ts",
      "import": "./dist/tournament-notification-recipient.js"
    },
    "./quarter-create": {
      "types": "./src/game-quarter-create-repository.ts",
      "import": "./dist/game-quarter-create-repository.js"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://padlhub.invalid/contracts/communities-role-split-acceptance-v1.schema.json",
  "title": "Communities role-split acceptance envelope v1",
  "description": "A review-only, redacted decision envelope. It is not an executable ACL plan and carries no role, migration, deployment, or runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "artifactSha256",
    "inputC",
    "mapping",
    "ownershipPlan",
    "grantPlan",
    "comparison",
    "decision"
  ],
  "properties": {
    "contractVersion": {
      "const": "communities-role-split-acceptance-v1"
    },
    "artifactSha256": {
      "$ref": "#/$defs/sha256"
    },
    "inputC": {
      "$ref": "#/$defs/inputC"
    },
    "mapping": {
      "$ref": "#/$defs/roleMapping"
    },
    "ownershipPlan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ownershipDecision"
      }
    },
    "grantPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/grantDecision"
      }
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stableCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,127}$"
    },
    "roleCategory": {
      "enum": [
        "RESTORE_OWNER",
        "RESTORE_EXECUTOR",
        "SHARED_OWNER",
        "FUTURE_MIGRATOR",
        "FUTURE_RUNTIME",
        "INVENTORY_READER"
      ]
    },
    "observationDigest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["observationState", "valueSha256", "provenanceSha256"],
          "properties": {
            "observationState": {
              "const": "OBSERVED"
            },
            "valueSha256": {
              "$ref": "#/$defs/sha256"
            },
            "provenanceSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["observationState", "valueSha256", "provenanceSha256"],
          "properties": {
            "observationState": {
              "enum": ["UNKNOWN", "UNOBSERVED"]
            },
            "valueSha256": {
              "type": "null"
            },
            "provenanceSha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    "observedBoolean": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["observationState", "value", "provenanceSha256"],
          "properties": {
            "observationState": {
              "const": "OBSERVED"
            },
            "value": {
              "type": "boolean"
            },
            "provenanceSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["observationState", "value", "provenanceSha256"],
          "properties": {
            "observationState": {
              "enum": ["UNKNOWN", "UNOBSERVED"]
            },
            "value": {
              "type": "null"
            },
            "provenanceSha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    "roleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "roleName",
        "roleOid",
        "canLogin",
        "superuser",
        "bypassRls",
        "createDatabase",
        "createRole",
        "replication"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/roleCategory"
        },
        "roleName": {
          "$ref": "#/$defs/observationDigest"
        },
        "roleOid": {
          "$ref": "#/$defs/observationDigest"
        },
        "canLogin": {
          "$ref": "#/$defs/observedBoolean"
        },
        "superuser": {
          "$ref": "#/$defs/observedBoolean"
        },
        "bypassRls": {
          "$ref": "#/$defs/observedBoolean"
        },
        "createDatabase": {
          "$ref": "#/$defs/observedBoolean"
        },
        "createRole": {
          "$ref": "#/$defs/observedBoolean"
        },
        "replication": {
          "$ref": "#/$defs/observedBoolean"
        }
      }
    },
    "roleMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RESTORE_OWNER",
        "RESTORE_EXECUTOR",
        "SHARED_OWNER",
        "FUTURE_MIGRATOR",
        "FUTURE_RUNTIME",
        "INVENTORY_READER",
        "identityRelations"
      ],
      "properties": {
        "RESTORE_OWNER": {
          "allOf": [
            {
              "$ref": "#/$defs/roleBinding"
            },
            {
              "properties": {
                "category": {
                  "const": "RESTORE_OWNER"
                }
              }
            }
          ]
        },
        "RESTORE_EXECUTOR": {
          "allOf": [
            {
              "$ref": "#/$defs/roleBinding"
            },
            {
              "properties": {
                "category": {
                  "const": "RESTORE_EXECUTOR"
                }
              }
            }
          ]
        },
        "SHARED_OWNER": {
          "allOf": [
            {
              "$ref": "#/$defs/roleBinding"
            },
            {
              "properties": {
                "category": {
                  "const": "SHARED_OWNER"
                }
              }
            }
          ]
        },
        "FUTURE_MIGRATOR": {
          "allOf": [
            {
              "$ref": "#/$defs/roleBinding"
            },
            {
              "properties": {
                "category": {
                  "const": "FUTURE_MIGRATOR"
                }
              }
            }
          ]
        },
        "FUTURE_RUNTIME": {
          "allOf": [
            {
              "$ref": "#/$defs/roleBinding"
            },
            {
              "properties": {
                "category": {
                  "const": "FUTURE_RUNTIME"
                }
              }
            }
          ]
        },
        "INVENTORY_READER": {
          "allOf": [
            {
              "$ref": "#/$defs/roleBinding"
            },
            {
              "properties": {
                "category": {
                  "const": "INVENTORY_READER"
                }
              }
            }
          ]
        },
        "identityRelations": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_OWNER" },
                    "right": { "const": "RESTORE_EXECUTOR" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_OWNER" },
                    "right": { "const": "SHARED_OWNER" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_OWNER" },
                    "right": { "const": "FUTURE_MIGRATOR" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_OWNER" },
                    "right": { "const": "FUTURE_RUNTIME" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_OWNER" },
                    "right": { "const": "INVENTORY_READER" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_EXECUTOR" },
                    "right": { "const": "SHARED_OWNER" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_EXECUTOR" },
                    "right": { "const": "FUTURE_MIGRATOR" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_EXECUTOR" },
                    "right": { "const": "FUTURE_RUNTIME" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "RESTORE_EXECUTOR" },
                    "right": { "const": "INVENTORY_READER" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "SHARED_OWNER" },
                    "right": { "const": "FUTURE_MIGRATOR" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "SHARED_OWNER" },
                    "right": { "const": "FUTURE_RUNTIME" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "SHARED_OWNER" },
                    "right": { "const": "INVENTORY_READER" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "FUTURE_MIGRATOR" },
                    "right": { "const": "FUTURE_RUNTIME" },
                    "requirement": { "const": "REQUIRED_DISTINCT" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "FUTURE_MIGRATOR" },
                    "right": { "const": "INVENTORY_READER" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/identityRelation" },
                {
                  "properties": {
                    "left": { "const": "FUTURE_RUNTIME" },
                    "right": { "const": "INVENTORY_READER" },
                    "requirement": { "const": "ALIAS_ALLOWED" }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "identityRelation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "requirement", "relation", "provenanceSha256"],
          "properties": {
            "left": {
              "$ref": "#/$defs/roleCategory"
            },
            "right": {
              "$ref": "#/$defs/roleCategory"
            },
            "requirement": {
              "enum": ["REQUIRED_DISTINCT", "ALIAS_ALLOWED"]
            },
            "relation": {
              "enum": ["SAME", "DISTINCT"]
            },
            "provenanceSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "requirement", "relation", "provenanceSha256"],
          "properties": {
            "left": {
              "$ref": "#/$defs/roleCategory"
            },
            "right": {
              "$ref": "#/$defs/roleCategory"
            },
            "requirement": {
              "enum": ["REQUIRED_DISTINCT", "ALIAS_ALLOWED"]
            },
            "relation": {
              "enum": ["UNKNOWN", "UNOBSERVED"]
            },
            "provenanceSha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "markerDigest",
        "requestDigest",
        "cloneNamePatternValid",
        "cloneOidBound",
        "sourceOidBound",
        "systemIdentifierDigest",
        "pgMajor",
        "objectManifestDigest",
        "ledgerDigest",
        "ledgerCount"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "minLength": 1
        },
        "markerDigest": {
          "$ref": "#/$defs/sha256"
        },
        "requestDigest": {
          "$ref": "#/$defs/sha256"
        },
        "cloneNamePatternValid": {
          "const": true
        },
        "cloneOidBound": {
          "const": true
        },
        "sourceOidBound": {
          "const": true
        },
        "systemIdentifierDigest": {
          "$ref": "#/$defs/sha256"
        },
        "pgMajor": {
          "const": 16
        },
        "objectManifestDigest": {
          "$ref": "#/$defs/sha256"
        },
        "ledgerDigest": {
          "$ref": "#/$defs/sha256"
        },
        "ledgerCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "normalizedRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalKeySha256", "observationState", "valueSha256", "provenanceSha256"],
          "properties": {
            "canonicalKeySha256": {
              "$ref": "#/$defs/sha256"
            },
            "observationState": {
              "const": "OBSERVED"
            },
            "valueSha256": {
              "$ref": "#/$defs/sha256"
            },
            "provenanceSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonicalKeySha256", "observationState", "valueSha256", "provenanceSha256"],
          "properties": {
            "canonicalKeySha256": {
              "$ref": "#/$defs/sha256"
            },
            "observationState": {
              "enum": ["UNKNOWN", "UNOBSERVED"]
            },
            "valueSha256": {
              "type": "null"
            },
            "provenanceSha256": {
              "type": "null"
            }
          }
        }
      ]
    },
    "normalizedInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "memberships",
        "databaseAcl",
        "schemas",
        "defaultAcls",
        "relations",
        "columnAcls",
        "rlsPolicies",
        "sequences",
        "functions",
        "types",
        "extensions"
      ],
      "properties": {
        "roles": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "memberships": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "databaseAcl": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "schemas": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "defaultAcls": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "relations": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "columnAcls": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "rlsPolicies": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "sequences": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "functions": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "types": {
          "$ref": "#/$defs/normalizedRecords"
        },
        "extensions": {
          "$ref": "#/$defs/normalizedRecords"
        }
      }
    },
    "normalizedRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalizedRecord"
      }
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "canonicalKeySha256", "evidenceSha256"],
      "properties": {
        "code": {
          "$ref": "#/$defs/stableCode"
        },
        "canonicalKeySha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputC": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "canonicalizationVersion",
        "sortVersion",
        "manifestSha256",
        "provenance",
        "normalized",
        "anomalies"
      ],
      "properties": {
        "schemaVersion": {
          "const": "communities-role-split-input-c-v1"
        },
        "canonicalizationVersion": {
          "const": "utf8-byte-digest-v1"
        },
        "sortVersion": {
          "const": "sha256-byte-v1"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "normalized": {
          "$ref": "#/$defs/normalizedInventory"
        },
        "anomalies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anomaly"
          }
        }
      }
    },
    "ownerCategory": {
      "oneOf": [
        {
          "$ref": "#/$defs/roleCategory"
        },
        {
          "const": "PRESERVE_CURRENT"
        }
      ]
    },
    "ownershipDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKind",
        "canonicalKeySha256",
        "beforeOwnerCategory",
        "targetOwnerCategory",
        "ruleSha256",
        "provenanceSha256"
      ],
      "properties": {
        "objectKind": {
          "enum": ["database", "schema", "relation", "sequence", "function", "type", "extension"]
        },
        "canonicalKeySha256": {
          "$ref": "#/$defs/sha256"
        },
        "beforeOwnerCategory": {
          "$ref": "#/$defs/roleCategory"
        },
        "targetOwnerCategory": {
          "$ref": "#/$defs/ownerCategory"
        },
        "ruleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenanceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "grantDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKind",
        "canonicalKeySha256",
        "action",
        "granteeCategory",
        "privileges",
        "beforeStateSha256",
        "targetStateSha256",
        "grantOption",
        "ruleSha256",
        "provenanceSha256"
      ],
      "properties": {
        "objectKind": {
          "enum": ["database", "schema", "relation", "sequence", "function", "type"]
        },
        "canonicalKeySha256": {
          "$ref": "#/$defs/sha256"
        },
        "action": {
          "enum": ["PRESERVE", "ADD", "REMOVE"]
        },
        "granteeCategory": {
          "$ref": "#/$defs/roleCategory"
        },
        "privileges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONNECT",
              "TEMPORARY",
              "USAGE",
              "CREATE",
              "SELECT",
              "INSERT",
              "UPDATE",
              "DELETE",
              "TRUNCATE",
              "REFERENCES",
              "TRIGGER",
              "EXECUTE"
            ]
          }
        },
        "beforeStateSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetStateSha256": {
          "$ref": "#/$defs/sha256"
        },
        "grantOption": {
          "const": false
        },
        "ruleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenanceSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "action": { "const": "PRESERVE" } },
            "required": ["action"]
          },
          "then": {
            "properties": { "privileges": { "maxItems": 0 } }
          },
          "else": {
            "properties": { "privileges": { "minItems": 1 } }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sortVersion",
        "beforeManifestSha",
        "afterManifestSha",
        "changedCount",
        "addedCount",
        "removedCount",
        "forbiddenTransitionCodes"
      ],
      "properties": {
        "sortVersion": {
          "const": "sha256-byte-v1"
        },
        "beforeManifestSha": {
          "$ref": "#/$defs/sha256"
        },
        "afterManifestSha": {
          "$ref": "#/$defs/sha256"
        },
        "changedCount": {
          "type": "integer",
          "minimum": 0
        },
        "addedCount": {
          "type": "integer",
          "minimum": 0
        },
        "removedCount": {
          "type": "integer",
          "minimum": 0
        },
        "forbiddenTransitionCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableCode"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blockerCodes",
        "authorizesRoleCreation",
        "authorizesRoleAlteration",
        "authorizesAclMutation",
        "authorizesMigration",
        "authorizesDeploy",
        "authorizesRuntimeActivation"
      ],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL"]
        },
        "blockerCodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableCode"
          }
        },
        "authorizesRoleCreation": {
          "const": false
        },
        "authorizesRoleAlteration": {
          "const": false
        },
        "authorizesAclMutation": {
          "const": false
        },
        "authorizesMigration": {
          "const": false
        },
        "authorizesDeploy": {
          "const": false
        },
        "authorizesRuntimeActivation": {
          "const": false
        }
      }
    }
  },
  "x-role-categories": [
    "RESTORE_OWNER",
    "RESTORE_EXECUTOR",
    "SHARED_OWNER",
    "FUTURE_MIGRATOR",
    "FUTURE_RUNTIME",
    "INVENTORY_READER"

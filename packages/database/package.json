{
  "name": "@phub/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts src/contact-reader.ts src/local-password-login-repository.ts src/local-password-reset-repository.ts --format esm --dts --sourcemap --clean"
  },
  "dependencies": {
    "@phub/communities": "0.1.0",
    "@phub/domain": "0.1.0",
    "@phub/games": "0.1.0",
    "@phub/gift-certificates": "0.1.0",
    "@phub/home-projection": "0.1.0",
    "@phub/locations": "0.1.0",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contacts": {
      "types": "./src/contact-reader.ts",
      "import": "./dist/contact-reader.js"
    },
    "./password-login": {
      "types": "./src/local-password-login-repository.ts",
      "import": "./dist/local-password-login-repository.js"
    },
    "./password-reset": {
      "types": "./src/local-password-reset-repository.ts",
      "import": "./dist/local-password-reset-repository.js"
    }
  }
}

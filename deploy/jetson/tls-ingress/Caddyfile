{
    admin off
    log {
        output stdout
        format json
    }
}

(nano_security) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "same-origin"
        -Server
    }
}

# Viva still has this exact callback origin. Bounce it to the canonical HTTPS
# host before the API consumes the one-time state, so the host-only refresh
# cookie is issued for lk.nano.padlhub.su instead of the legacy IP.
http://185.155.18.146 {
    @viva_callback path /user/api/v1/*/auth/viva/callback
    redir @viva_callback https://lk.nano.padlhub.su{uri} 302
    redir https://lk.nano.padlhub.su{uri} permanent
}

nano.padlhub.su {
    import nano_security
    redir https://lk.nano.padlhub.su{uri} permanent
}

lk.nano.padlhub.su {
    import nano_security
    reverse_proxy nginx:80
}

api.nano.padlhub.su {
    import nano_security
    reverse_proxy api:3000
}

cup.nano.padlhub.su {
    import nano_security

    # The CUP browser remains a PadlHub client. Keep authenticated API calls
    # same-origin; all other paths stay on the CUP showcase.
    @padlhub_api path /user/api/* /admin/api/* /public/api/*
    handle @padlhub_api {
        reverse_proxy api:3000
    }

    handle {
        reverse_proxy showcase-proxy:80
    }
}

swagger.nano.padlhub.su {
    import nano_security
    reverse_proxy swagger-ui:8080
}

portainer.nano.padlhub.su {
    import nano_security
    basic_auth {
        nano-admin {$PORTAINER_AUTH_HASH}
    }
    reverse_proxy https://portainer:9443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

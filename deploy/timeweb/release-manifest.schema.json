{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PadlHub Timeweb canonical same-run publication release manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "gitCommit",
    "gitTree",
    "platform",
    "publication",
    "baseLock",
    "baseImages",
    "images"
  ],
  "properties": {
    "schemaVersion": { "const": "PHUB_TIMEWEB_RELEASE_MANIFEST_V2" },
    "repository": { "const": "Z6v6e6r/lk2" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "gitTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platform": { "const": "linux/amd64" },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "workflowSha", "runId", "runAttempt"],
      "properties": {
        "workflow": { "const": ".github/workflows/publish-timeweb-amd64-images.yaml" },
        "workflowSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "const": "1" }
      }
    },
    "baseLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256"],
      "properties": {
        "schema": { "const": "PHUB_TIMEWEB_BASE_IMAGES_V2" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "baseImages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "registry", "repository", "tag", "indexDigest", "manifestDigest"],
        "properties": {
          "id": {
            "enum": ["buildkit-syft-scanner", "nginx-web-runtime", "node-runtime-build-base"]
          },
          "registry": { "const": "docker.io" },
          "repository": { "type": "string" },
          "tag": { "type": "string" },
          "indexDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "manifestDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["component", "repository"],
            "properties": {
              "component": { "const": "web" },
              "repository": { "const": "ghcr.io/z6v6e6r/phub-web" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["component", "repository"],
            "properties": {
              "component": { "const": "api" },
              "repository": { "const": "ghcr.io/z6v6e6r/phub-api" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["component", "repository"],
            "properties": {
              "component": { "const": "worker" },
              "repository": { "const": "ghcr.io/z6v6e6r/phub-worker" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["component", "repository"],
            "properties": {
              "component": { "const": "realtime" },
              "repository": { "const": "ghcr.io/z6v6e6r/phub-realtime" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["component", "repository"],
            "properties": {
              "component": { "const": "migrator" },
              "repository": { "const": "ghcr.io/z6v6e6r/phub-migrator" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "repository",
          "digest",
          "runtimeDigest",
          "architecture",
          "revision",
          "provenance",
          "provenanceSubject",
          "sbom",
          "sbomSubject",
          "sourceMaterialSha",
          "publication"
        ],
        "properties": {
          "component": {
            "type": "string",
            "enum": ["web", "api", "worker", "realtime", "migrator"]
          },
          "repository": {
            "type": "string",
            "pattern": "^ghcr\\.io/z6v6e6r/phub-(web|api|worker|realtime|migrator)$"
          },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "runtimeDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "architecture": { "const": "amd64" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "provenance": { "const": true },
          "provenanceSubject": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "sbom": { "const": true },
          "sbomSubject": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "sourceMaterialSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "publication": { "const": true }
        }
      }
    }
  }
}

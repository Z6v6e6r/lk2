{
  "name": "@phub/viva-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts src/notification-lifecycle-source.ts --format esm --dts --sourcemap --clean"
  },
  "dependencies": {
    "@phub/auth": "0.1.0",
    "@phub/domain": "0.1.0",
    "jose": "6.2.3",
    "zod": "4.6.7"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./notification-lifecycle": {
      "types": "./src/notification-lifecycle-source.ts",
      "import": "./dist/notification-lifecycle-source.js"
    }
  }
}

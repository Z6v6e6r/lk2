{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@phub/api-contracts": ["packages/api-contracts/src/index.ts"],
      "@phub/api-sdk": ["packages/api-sdk/src/index.ts"],
      "@phub/auth": ["packages/auth/src/index.ts"],
      "@phub/auth/viva-delegation": ["packages/auth/src/viva-delegation.ts"],
      "@phub/communities": ["packages/communities/src/index.ts"],
      "@phub/config": ["packages/config/src/index.ts"],
      "@phub/database": ["packages/database/src/index.ts"],
      "@phub/domain": ["packages/domain/src/index.ts"],
      "@phub/games": ["packages/games/src/index.ts"],
      "@phub/gift-certificates": ["packages/gift-certificates/src/index.ts"],
      "@phub/home-projection": ["packages/home-projection/src/index.ts"],
      "@phub/legacy-games-adapter": ["packages/legacy-games-adapter/src/index.ts"],
      "@phub/locations": ["packages/locations/src/index.ts"],
      "@phub/notifications": ["packages/notifications/src/index.ts"],
      "@phub/observability": ["packages/observability/src/index.ts"],
      "@phub/subscription-runtime-adapter": ["packages/subscription-runtime-adapter/src/index.ts"],
      "@phub/testing": ["packages/testing/src/index.ts"],
      "@phub/ui": ["packages/ui/src/index.tsx"],
      "@phub/viva-adapter": ["packages/viva-adapter/src/index.ts"],
      "@phub/viva-client-adapter": ["packages/viva-client-adapter/src/index.ts"],
      "@phub/database/managed-self-leave": [
        "packages/database/src/managed-self-leave-repository.ts"
      ],
      "@phub/database/contacts": ["packages/database/src/contact-reader.ts"],
      "@phub/database/password-login": ["packages/database/src/local-password-login-repository.ts"],
      "@phub/database/support-tickets": ["packages/database/src/support-ticket-repository.ts"],
      "@phub/database/password-reset": ["packages/database/src/local-password-reset-repository.ts"],
      "@phub/domain/notification-scenarios": ["packages/domain/src/notification-scenarios.ts"],
      "@phub/database/notification-scenarios": [
        "packages/database/src/notification-scenario-repository.ts"
      ],
      "@phub/viva-adapter/notification-lifecycle": [
        "packages/viva-adapter/src/notification-lifecycle-source.ts"
      ],
      "@phub/domain/quarter-create": ["packages/domain/src/quarter-create.ts"],
      "@phub/database/quarter-create": ["packages/database/src/game-quarter-create-repository.ts"],
      "@phub/domain/training-registration": ["packages/domain/src/training-registration.ts"],
      "@phub/database/training-registration": [
        "packages/database/src/training-registration-repository.ts"
      ]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps", "packages", "scripts", "*.ts"],
  "exclude": ["node_modules", "**/dist/**", "apps/mobile/android", "apps/mobile/ios"]
}

        </mxCell>
        <mxCell id="22" value="Эквайринг / фискализация&#xa;tokenization, signed webhooks, statements" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="20">
          <mxGeometry x="35" y="245" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Email / Push / Telegram / MAX&#xa;доставка является projection, не business truth" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="20">
          <mxGeometry x="35" y="410" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Viva: только санкционированный export / archive&#xa;versioned import, checksum, watermark, tombstones&#xa;нет runtime auth/read/write и client transport" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="20">
          <mxGeometry x="35" y="585" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="25" value="Cutover control: tenant + domain / station boundary → ровно один writer. DISCOVERED → BASELINE_EXPORTED → RECONCILED → LOCAL_PRIMARY → LOCAL_ONLY. Request-path dual-write запрещён." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="1110" width="1920" height="85" as="geometry" />
        </mxCell>
        <mxCell id="26" value="Zero-Viva acceptance: VIVA_MODE=disabled + egress deny-list + zero Viva DNS/HTTP + все P0 E2E проходят на local data + проверены backup/restore и rollback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="1240" width="1920" height="75" as="geometry" />
